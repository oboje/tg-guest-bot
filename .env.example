# BotFather token
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# Your numeric Telegram user id - the only id the bot answers
TELEGRAM_OWNER_ID=000000000
# Agent CLI to relay to
AGENT_BIN=claude
# Subcommand and flags placed before the prompt
AGENT_ARGS=-p
# Live status updates (1/0). Requires an agent that emits stream-json
AGENT_STREAM=1
AGENT_STREAM_ARGS=--output-format stream-json --verbose
# Directory the agent runs in
AGENT_WORKDIR=~/my
# Seconds before a run is killed
AGENT_TIMEOUT=600
# Long-polling window in seconds
POLL_TIMEOUT=30

# codex preset (no stream-json parsing - falls back to one blocking reply):
# AGENT_BIN=codex
# AGENT_ARGS=exec --skip-git-repo-check
# AGENT_STREAM=0

# Guest mode (BotFather -> Settings -> Guest Mode). Comma-separated ids allowed
# to summon the bot with @mention; empty means owner only
GUEST_ALLOWED_IDS=
# Seconds before a guest run is killed - one reply, keep it short
GUEST_TIMEOUT=120
