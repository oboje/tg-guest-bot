[Unit]
Description=Telegram guest bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=guest
WorkingDirectory=/opt/tg-guest-bot
ExecStart=/usr/bin/python3 /opt/tg-guest-bot/bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
